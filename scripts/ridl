#!/usr/bin/env python3
"""Run the vendored ridl toolchain: `scripts/ridl check|generate|drift`."""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "scripts" / "vendor"))

from ridl.cli import run

if __name__ == "__main__":
    argv = sys.argv[1:]
    if "--root" not in argv:
        argv += ["--root", str(ROOT)]
    raise SystemExit(run(argv))
