RUST_LOG=info,hhm_api=info
APP_ENV=development
HOST=0.0.0.0
PORT=8080
ORES_MIDDLEWARE_TLS_MODE=disabled
ORES_MIDDLEWARE_TRUSTED_PROXY_CIDRS=
ORES_MIDDLEWARE_TIMEOUT_MS=10000
ORES_MIDDLEWARE_MAX_BODY_BYTES=262144
ORES_MIDDLEWARE_RATE_LIMIT_CAPACITY=60
ORES_MIDDLEWARE_RATE_LIMIT_REFILL_PER_SECOND=1
# Required in production. Supply only from the approved secret store.
ORES_MIDDLEWARE_RATE_LIMIT_HMAC_SECRET=replace-me
DATABASE_URL=postgres://hhm_api:replace-me@primary-postgres.example:5432/hhm
SUPABASE_DATABASE_URL=postgres://postgres.bihpugkzayenywfyajnr:replace-me@aws-0-us-east-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://bihpugkzayenywfyajnr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me
TURNSTILE_ACTION=intake
SHARED_AUTH_BASE_URL=http://shared-auth.auth.svc.cluster.local
SHARED_AUTH_SERVICE_CREDENTIAL=replace-me
SHARED_AUTH_AUDIENCE=hhm-api
# Exact browser origins only. Wildcards, paths, queries, and non-HTTPS origins
# are rejected.
CORS_ORIGINS=https://hhaus.org,https://www.hhaus.org,https://medellin.hhaus.org,https://user.hhaus.org
